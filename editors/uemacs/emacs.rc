;	EMACS.RC / .emacsrc
;
;	Startup file for uEmacs/PK 4.0.15, executed every time the editor is
;	entered.  Petri Kutvonen's, less what only a DOS box or a serial
;	terminal could use: the $sres kludge and the PC branch under it,
;	the colour modes, the Latin-1 macros, the Sun $TERM test, EM.RC and
;	.emrc.  None of it ran, and some of it would have stopped the file:
;	an unforced FALSE ends one, and there is no $scroll and no colour.

set $discmd "FALSE"

;	Nothing here is not UTF-8, so there is no $LANG to test.

add-global-mode "utf-8"

;	Help facility.  F1 opens the browser and closes it again; on the
;	index it opens the topic under the cursor.  PgUp and PgDn walk the
;	sections.

40 	store-macro
	set $discmd "FALSE"
	!if &not &seq $cbufname "emacs.hlp"
		write-message "(Loading Help)"
		!force help
		!force 8 resize-window
		bind-to-key execute-macro-38 FN5
		bind-to-key execute-macro-37 FN6
		beginning-of-line
		2 forward-character
		1 redraw-display
		save-window
		execute-macro-39
	!else
		set %hlpcode &lef $line 2
		!if &seq %hlpcode ".."
			set %hlptopic &mid $line 4 99
			end-of-line
			!force search-forward %hlptopic
			beginning-of-line
			2 forward-character
			1 redraw-display
			execute-macro-39
		!else
			bind-to-key previous-page FN5
			bind-to-key next-page FN6
			!force restore-window
			!force delete-window
			clear-message-line
		!endif
	!endif
	set $discmd "TRUE"
!endm

bind-to-key execute-macro-40 M-?
bind-to-key execute-macro-40 FN;

;	Help on Help

39	store-macro
	!if &seq &rig $line 5 "INDEX"
		write-message "Select topic from list and press <F1>"
	!else
		write-message "Use <PgUp> / <PgDn> to scan help file -- <F1> to toggle help window"
	!endif
!endm

;	Previous help page

38 	store-macro
	!if &seq $cbufname "emacs.hlp"
		beginning-of-line
		!force search-reverse "=>"
		2 forward-character
		1 redraw-display
		execute-macro-39
	!else
		previous-page
	!endif
!endm

;	Next help page

37 	store-macro
	!if &seq $cbufname "emacs.hlp"
		beginning-of-line
		2 forward-character
		!force search-forward "=>"
		1 redraw-display
		execute-macro-39
	!else
		next-page
	!endif
!endm

;	Modes by file name, run on every file read

36	store-macro
	set %rctmp &sin $cfname "."
	!if &equ %rctmp 0
		!return
	!endif
	set %rctmp &mid $cfname &add %rctmp 1 5
	!if &or &seq %rctmp "c" &or &seq %rctmp "h" &seq %rctmp "cpp"
		add-mode "cmode"
	!endif
	!if &or &seq %rctmp "txt" &or &seq %rctmp "md" &seq %rctmp "tex"
		add-mode "wrap"
	!endif
!endm

bind-to-key execute-macro-36	M-FNR

;	F10, which upstream's PC branch bound and no key could reach

bind-to-key exit-emacs		FND

set $discmd "TRUE"
