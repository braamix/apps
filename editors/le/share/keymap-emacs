backward-char           ^B
forward-char            ${Right}
forward-char            ^F
backward-word           \e|${Left}
backward-word           ${C-Left}
backward-word           \e|b
backward-word           \e|B
forward-word            \e|${Right}
forward-word            ${C-Right}
forward-word            \e|f
forward-word            \e|F
