10 REM STAR PATTERN GENERATOR
20 REM CREATES A TRIANGLE OF STARS
30 PRINT "STAR TRIANGLE"
40 PRINT "============="
50 PRINT
60 INPUT "NUMBER OF ROWS"; R
70 PRINT
80 FOR I = 1 TO R
