echo cc -c a.c -o a.o [a] [a.c hdr.h]
cc -c a.c -o a.o [a] [a.c hdr.h]
echo cc -c b.c -o b.o [b] [b.c hdr.h]
cc -c b.c -o b.o [b] [b.c hdr.h]
echo special bb.o [b]
special bb.o [b]
echo cc -c x.c -o x.o [x] [x.c hdr.h]
cc -c x.c -o x.o [x] [x.c hdr.h]
echo in sub sub/a.o [a] a.c
in sub sub/a.o [a] a.c
echo in sub sub/x.o [x] x.c
in sub sub/x.o [x] x.c
echo link a.o b.o bb.o x.o sub/a.o sub/x.o [a.o b.o bb.o x.o sub/a.o sub/x.o]
link a.o b.o bb.o x.o sub/a.o sub/x.o [a.o b.o bb.o x.o sub/a.o sub/x.o]
