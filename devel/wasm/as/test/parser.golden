=== first look
(module
  (import "env" "puts" (func $puts (param i32)))
  (memory (export "memory") 1)
  (data (i32.const 16) "hello\00")
  (func $main (export "main") (result i32)
    (local $i i32)
    (call $puts (i32.const 16))
    (local.set $i (i32.const 3))
    (block $done
      (loop $again
        (br_if $done (i32.eqz (local.get $i)))
        local.get $i
        i32.const 1
        i32.sub
        local.set $i
        br $again))
    i32.const 0))
---
(Module _ [
  (Import "env" "puts" (FuncImport $puts (TypeUse _ [(Param _ I32)] [])) [])
  (Memory _ ["memory"] (MemType Addr32 (Limits 1 _) false _) _)
  (Data _ (DataActive 0 [
    (I32Const 16)]) "hello\00")
  (Func $main ["main"] (TypeUse _ [] [I32]) [(Local $i I32)] [
    (I32Const 16)
    (Index call $puts)
    (I32Const 3)
    (Index local.set $i)
    (Block block $done NoResult [
      (Block loop $again NoResult [
        (Index local.get $i)
        (Plain i32.eqz)
        (Br br_if $done _)
        (Index local.get $i)
        (I32Const 1)
        (Plain i32.sub)
        (Index local.set $i)
        (Br br $again _)])])
    (I32Const 0)])])

