(Module _ [
  (Memory _ [] (MemType Addr32 (Limits 1 1) true _) _)
  (Func _ [] (TypeUse _ [] []) [] [
    (Plain atomic.fence)
    (MemArg i32.atomic.load 0 0 4)
    (MemArg i64.atomic.rmw.add 0 8 8)
    (MemArg memory.atomic.notify 0 0 4)
