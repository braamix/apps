=== if without else
(func
  i32.const 0 if nop end
  (if (i32.const 1) (then nop))
  i32.const 2 if $l (result i32) i32.const 3 else $l i32.const 4 end $l drop
  (if (result i32) (i32.const 5) (then (i32.const 6)) (else (i32.const 7))) drop)
---
(Module _ [
  (Func _ [] (TypeUse _ [] []) [] [
    (I32Const 0)
    (If _ NoResult [
      (Plain nop)] false [] _)
    (I32Const 1)
    (If _ NoResult [
      (Plain nop)] false [] _)
    (I32Const 2)
    (If $l (Result I32) [
      (I32Const 3)] true [
      (I32Const 4)] _)
    (Plain drop)
    (I32Const 5)
    (If _ (Result I32) [
      (I32Const 6)] true [
      (I32Const 7)] _)
    (Plain drop)])])

