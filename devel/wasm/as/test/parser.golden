  (Elem _ ElemPassive (Funcs [$f]))
  (Elem _ ElemPassive (Exprs (RefType true (Abstract HExtern)) []))
  (Elem _ ElemDeclare (Funcs [$f 1]))
  (Elem _ (ElemActive 0 [
    (I32Const 4)]) (Funcs []))])

=== data segments
(data "a" "b") (data $d (i32.const 0) "c") (data (memory $m) (offset i32.const 1))
(data (memory 1) (i64.const 2) "d") (data $e)
---
(Module _ [
  (Data _ DataPassive "ab")
  (Data $d (DataActive 0 [
    (I32Const 0)]) "c")
  (Data _ (DataActive $m [
    (I32Const 1)]) "")
  (Data _ (DataActive 1 [
    (I64Const 2)]) "d")
  (Data $e DataPassive "")])

=== quoted ids
(func $"a b" (param $"\u{3bb}" i32) block $"x y" br $"x y" end call $"a b")
---
(Module _ [
  (Func $"a b" [] (TypeUse _ [(Param $"\ce\bb" I32)] []) [] [
    (Block block $"x y" NoResult [
      (Br br $"x y" _)])
    (Index call $"a b")])])

=== annotations
(@custom "c0") (module (@name "M") (@unknown x (y) "z")
  (@custom "c1" (before first) "a" "b") (func $f (@name "λ") (param $x (@name "α") i32) (local (@name "l") i32)
    (@metadata.code.branch_hint "\01") (if (local.get 0) (then))
    local.get 0 (@metadata.code.branch_hint "\00") br_if 0
    local.get 0 (@metadata.code.branch_hint "\00") if end)
  (@custom "c2" (after code)) (@custom "c3" (after last) "x") (@custom "c4" (before datacount)))
---
(Module @"M" [
  (Custom "c0" AfterLast "")
  (Custom "c1" BeforeFirst "ab")
  (Func $f@"\ce\bb" [] (TypeUse _ [(Param $x@"\ce\b1" I32)] []) [(Local @"l" I32)] [
    (Index local.get 0)
    (If _ NoResult [] false [] Likely)
    (Index local.get 0)
    (Br br_if 0 Unlikely)
    (Index local.get 0)
    (If _ NoResult [] false [] Unlikely)])
  (Custom "c2" (After CodeSec) "")
  (Custom "c3" AfterLast "x")
  (Custom "c4" (Before DataCountSec) "")])

=== extensions
(memory 1 1 shared) (func atomic.fence i32.atomic.load i64.atomic.rmw.add offset=8
  memory.atomic.notify i64.add128 i64.sub128 i64.mul_wide_s i64.mul_wide_u
  i8x16.relaxed_swizzle f32x4.relaxed_madd i32x4.relaxed_dot_i8x16_i7x16_add_s)
